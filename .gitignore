# ---- Unity 标准忽略（基于 Unity 官方模板，Unity 6 适用）----

# Unity 生成目录
/[Bb]uild/
/[Bb]uilds/
/[Ll]ibrary/
/[Ll]ogs/
/[Oo]bj/
/[Tt]emp/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Visual Studio / Rider / VS Code 客户端生成
.vs/
.idea/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 元数据与崩溃
sysinfo.txt
crashlytics-build.properties
*.stackdump

# Burst
/[Bb]urstCompiler.cache/

# Addressables 构建产物
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# 包管理
/[Pp]ackages/packages-lock.json

# 插件 DLL 调试符号按需保留，默认忽略 pdb
*.pdb.meta

# 构建产物
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dmg
*.x86
*.x86_64
*.run

# ---- 操作系统杂项 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地工作流状态（OpenCode/OhMyOpenCode）----
.omo/
.workbuddy/

# ---- dotnet / C# LSP 本地验证临时工程 ----
.tmp-dotnet/
